APP_NAME=CafeFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (MySQL 8). Inside docker compose the host is "mysql". ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=cafeflow
DB_USERNAME=cafeflow
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Mail. Local dev uses Mailpit (UI: http://localhost:8025). Set MAIL_MAILER=log to write mail to the log instead. ---
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="orders@cafeflow.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- CafeFlow business settings ---
CAFEFLOW_CURRENCY=USD
CAFEFLOW_TAX_RATE=0.08
CAFEFLOW_DELIVERY_FEE=4.50
CAFEFLOW_FREE_DELIVERY_OVER=50.00
CAFEFLOW_ALLOW_NEGATIVE_STOCK=false
CAFEFLOW_LOW_STOCK_EMAIL=ops@cafeflow.test
# Demo accounts are only seeded when APP_ENV is local or testing.
CAFEFLOW_DEMO_PASSWORD=CafeFlow!2026

# --- Python analytics service (never exposed to the browser) ---
ANALYTICS_SERVICE_URL=http://analytics:8001
ANALYTICS_SERVICE_KEY=change-me
ANALYTICS_TIMEOUT=5
ANALYTICS_RETRIES=2
ANALYTICS_CACHE_SECONDS=300

# --- Payments: "mock" (local test gateway) or "stripe" (Stripe test mode) ---
PAYMENT_GATEWAY=mock
MOCK_PAYMENT_WEBHOOK_SECRET=change-me
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"
